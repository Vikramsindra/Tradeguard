# Application
APP_ENV=development
# Must be at least 16 characters — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Database (use %40 to URL-encode @ in passwords)
DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/tradeguard
TEST_DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/tradeguard_test

# Gemini — server-side only, never sent to browser
GEMINI_API_KEY=your-gemini-api-key-here

# Mode — never switch silently (SIMULATOR | ORGANIZER_SANDBOX | LIVE)
TRADING_MODE=SIMULATOR

# Risk limits (configurable per deployment)
MAX_ORDER_QUANTITY_UNITS=10000
MAX_ORDER_NOTIONAL_INR=5000000
MAX_RULE_NOTIONAL_INR=1000000

# Quote freshness
MAX_QUOTE_AGE_MS=5000
MAX_DRIFT_BPS=50
CLOCK_SKEW_TOLERANCE_SECONDS=5

# Approval window
PROPOSAL_APPROVAL_TTL_SECONDS=120

# Worker
WORKER_POLL_INTERVAL_SECONDS=2

# Rate limiting
APPROVAL_RATE_LIMIT_PER_MINUTE=10
